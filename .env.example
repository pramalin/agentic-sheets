POSTGRES_DB=agentic_sheets
POSTGRES_USER=agentic_sheets
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Step 6: the mapping agent. Required for /internal/mapping/propose to
# work at all -- everything else in this project runs fine without it.
OPENAI_API_KEY=

# Step 7: dispatch auth. This is a fake value for testing against this
# project's own /internal/fake-target endpoint (see holdings.yaml's
# target.endpoint) -- not a real secret. A real deployment would source
# this from wherever holdings-writer's actual credential lives.
HOLDINGS_WRITER_API_KEY=dev-fake-secret

# Step 8: auth for agentic-sheets' own /internal/** API (see
# ApiKeyAuthFilter). A real local-dev default, not left blank like
# OPENAI_API_KEY -- this is this project's own secret, not an external
# credential with a cost/billing reason to keep blank. Change this
# before deploying anywhere that isn't your own machine.
AGENTIC_SHEETS_API_KEY=dev-local-secret
