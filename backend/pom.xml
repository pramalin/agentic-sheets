<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Same version already proven working in sheets-reader-mcp's own
             build in this environment — Spring AI 2.0.0's release notes
             specifically target this Boot version, and Boot 3.5.x mixed
             with Spring AI 2.0 fails at startup (Jackson 2 vs 3 conflict). -->
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.alai</groupId>
    <artifactId>agentic-sheets-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>agentic-sheets-backend</name>
    <description>
        Spring Boot backend for agentic-sheets. Step 4: CanonicalModelRegistry
        (parses canonical-models/*.yaml and client-configs/*.yaml into typed,
        validated objects) plus a JDBC connection to the orchestration
        Postgres schema. Spring AI (MCP client, tool-calling agent) arrives
        in Step 5; repository/DAO code for the orchestration tables arrives
        when something actually needs to read or write them.
    </description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Plain JDBC, not JPA/Hibernate — Step 4 only needs the
             orchestration schema to exist and be reachable (surfaced via
             actuator's db health indicator). Real repository/DAO code for
             import_batch, mapping_proposal, etc. arrives in later steps
             when something actually reads/writes them; no ORM layer
             speculatively added ahead of that. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Declared explicitly rather than relying on it arriving
             transitively via spring-boot-starter (which pulls it in for
             application.yml support) — canonical-models/*.yaml and
             client-configs/*.yaml come from various teams, not just this
             project's own authors, so this needs to be a stable, visible
             dependency rather than an implicit one. Version is
             BOM-managed by spring-boot-starter-parent. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>agentic-sheets-backend</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
